<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
        Directory for avatar files. An absolute path is used as is,
        a relative path is resolved against the user's home directory.
    -->
    <context-param>
        <param-name>avatarDir</param-name>
        <param-value>jee-avatars</param-value>
    </context-param>

    <!--
        H2 database stored in a file (~/jee-aquarium-db.mv.db), started in embedded mode
        together with the application server. AUTO_SERVER lets other tools (e.g. the IntelliJ
        Database window) open the same file while the application is running.
    -->
    <data-source>
        <name>java:app/jdbc/AquariumDS</name>
        <class-name>org.h2.jdbcx.JdbcDataSource</class-name>
        <url>jdbc:h2:file:~/jee-aquarium-db;AUTO_SERVER=TRUE</url>
        <user>sa</user>
        <password>sa</password>
    </data-source>

    <!-- Comments in .xhtml files are notes for developers, do not send them to the browser. -->
    <context-param>
        <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <!--
        Do not let browsers cache CSS and images for a week (Mojarra's default),
        so changes in style.css are visible after a restart.
    -->
    <context-param>
        <param-name>com.sun.faces.defaultResourceMaxAge</param-name>
        <param-value>0</param-value>
    </context-param>

    <!-- Jakarta Faces: every *.xhtml page is processed by the Faces servlet. -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- Keep the session id in a cookie only, so it is not appended to links as ;jsessionid=... -->
    <session-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Home page: the list of aquariums. -->
    <welcome-file-list>
        <welcome-file>aquarium/list.xhtml</welcome-file>
    </welcome-file-list>

</web-app>
