<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Container managed (JTA) unit; EntityManager is injected with @PersistenceContext. -->
    <persistence-unit name="aquariumPu" transaction-type="JTA">
        <jta-data-source>java:app/jdbc/AquariumDS</jta-data-source>

        <class>pl.edu.pg.eti.kask.aquarium.user.entity.User</class>
        <class>pl.edu.pg.eti.kask.aquarium.aquarium.entity.Aquarium</class>
        <class>pl.edu.pg.eti.kask.aquarium.fish.entity.Fish</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Schema is recreated on every start, test data is loaded by InitializedData. -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>
